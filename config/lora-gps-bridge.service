[Unit]
Description=NMEA bridge gpsd -> /dev/lora-gps for the LoRa packet forwarder
After=gpsd.service
Requires=gpsd.service
Before=lora-pkt-fwd.service

[Service]
Type=simple
ExecStart=/usr/bin/socat -d pty,raw,echo=0,link=/dev/lora-gps,mode=0660,group=dialout EXEC:"/usr/bin/gpspipe -r"
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
