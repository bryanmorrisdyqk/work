# ============================================================================
# Параметры установки GPS-таймстемпов для Waveshare SX1302/SX1303 HAT (RPi 4)
# Скопируйте в /etc/lora-gateway/gateway.env (или рядом: ./gateway.env)
# и отредактируйте под свой шлюз.
# ============================================================================

# --- Железо / плата -------------------------------------------------------
# Пины сброса концентратора (BCM). Значения по умолчанию — из референс-дизайна
# Semtech CoreCell, которому следует плата Waveshare. Если util_chip_id не
# читает EUI — проверьте распиновку своей ревизии платы.
SX1302_RESET_PIN=23
SX1302_POWER_EN_PIN=18
SX1261_RESET_PIN=32
AD5338R_RESET_PIN=13

# --- GPS ------------------------------------------------------------------
# UART, на который выведен NMEA-поток GNSS-модуля платы.
# /dev/ttyAMA0 — PL011 после dtoverlay=disable-bt (рекомендуется).
# /dev/ttyS0   — mini-UART, работает, но чувствителен к частоте ядра.
GPS_TTY=/dev/ttyAMA0
GPS_BAUD=9600

# Кто владеет UART с NMEA:
#   direct — пакет-форвардер читает UART напрямую (по умолчанию, проще и надёжнее),
#            chrony дисциплинирует системные часы по PPS + NTP.
#   gpsd   — UART держит gpsd (chrony берёт время через SHM), а форвардеру
#            отдаётся псевдотерминал /dev/lora-gps через gpspipe+socat.
GPS_MODE=direct

# PPS на GPIO Raspberry Pi — ТОЛЬКО для системных часов.
# Метки времени LoRa-пакетов от него НЕ зависят: на плате PPS заведён
# аппаратно на сам концентратор.
ENABLE_PI_PPS=1
PPS_GPIO=4

# --- Пакет-форвардер ------------------------------------------------------
HAL_REPO=https://github.com/Lora-net/sx1302_hal.git
HAL_VERSION=V2.1.0
INSTALL_DIR=/opt/sx1302_hal
CONF_DIR=/etc/lora-gateway

# Шаблон global_conf.json из состава HAL (packet_forwarder/):
#   global_conf.json.sx1250.EU868  / .US915 / .AS923 / .AU915 / .CN490 / .KR920 ...
GLOBAL_CONF_TEMPLATE=global_conf.json.sx1250.EU868

# Режим fine timestamp (доступен только на SX1303):
#   all_sf        — SF5..SF12, BW125, меньше пропускная способность
#   high_capacity — SF5..SF10, BW125, выше пропускная способность
#   off           — выключить тонкие метки, оставить только GPS-время (tmms)
FTIME_MODE=all_sf

# Сетевой сервер (LNS). Для локальной проверки: 127.0.0.1 + tools/gwsniff.py
SERVER_ADDRESS=eu1.cloud.thethings.network
SERV_PORT_UP=1700
SERV_PORT_DOWN=1700

# Gateway EUI. Пусто — взять EUI концентратора (util_chip_id).
GATEWAY_ID=

# Опорные координаты (используются, если GPS не захвачен / fake_gps=true).
REF_LATITUDE=0.0
REF_LONGITUDE=0.0
REF_ALTITUDE=0
